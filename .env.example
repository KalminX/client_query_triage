# Django Configuration
DJANGO_SECRET_KEY=django-insecure-replace-this-in-production-demo-key-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# AI Provider Configuration
# AI_MODE: "mock" (default, runs locally without API key) or "claude" (uses Anthropic API)
AI_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Email Provider Configuration
# EMAIL_MODE: "demo" (default, simulated inbox) or "gmail" (uses Google Gmail API)
EMAIL_MODE=demo
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Notification Provider Configuration
# NOTIFICATION_MODE: "log" (default, records in DB and logs) or "slack" or "teams"
NOTIFICATION_MODE=log
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Worker Settings
WORKER_POLL_INTERVAL=2.0
WORKER_MAX_RETRIES=3
WORKER_LEASE_SECONDS=300

# Default Support SLAs (Minutes)
SLA_CRITICAL_MINUTES=30
SLA_HIGH_MINUTES=120
SLA_NORMAL_MINUTES=480
SLA_LOW_MINUTES=1440
